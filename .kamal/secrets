# Segredos da implantação. Este arquivo vai para o git, então NÃO tem valor
# nenhum: só diz de onde cada segredo vem. Os valores ficam em
# ~/.config/prisma/producao.env, fora do repositório (com permissão 600), e o
# bin/implantar os carrega no ambiente antes de rodar o Kamal
# (docs/implantacao.md, "Segredos"). Perder as chaves de criptografia é perder
# todos os dados cifrados: guarde uma cópia segura do producao.env.

SECRET_KEY_BASE=$SECRET_KEY_BASE

# O usuário do banco que o app usa (privilégios mínimos, tabela a tabela)
DATABASE_URL=$DATABASE_URL

ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT

# O dono do banco: só o MariaDB (acessório) e o hook de migração usam
MARIADB_ROOT_PASSWORD=$MARIADB_ROOT_PASSWORD

# O certificado e a chave do HTTPS (arquivos fora do repositório)
SSL_CERTIFICATE_PEM=$(cat "$HOME/.config/prisma/tls/prisma.crt")
SSL_PRIVATE_KEY_PEM=$(cat "$HOME/.config/prisma/tls/prisma.key")
