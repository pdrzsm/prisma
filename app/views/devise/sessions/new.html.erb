<% content_for :title, "Entrar · Prisma" %>

<%# Entrada do sistema, com as três faces do prisma: a marca num painel
    escuro de um lado e o formulário num cartão do outro, sobre o fundo claro
    e a terceira face. Em tela estreita as faces somem e a marca vai para cima
    do formulário. O nome aparece sempre com o desenho do logo (PRIƧM∀). Os
    avisos (erro de login, "Você saiu do sistema.") vêm do layout. %>
<div class="relative min-h-screen lg:grid lg:grid-cols-[2fr_3fr]">
  <%# Três tons, como as faces de um prisma: o painel escuro (marca-700), o
      fundo claro (marca-100) e uma terceira face (marca-300). Ela nasce de
      uma segunda quebra, que sobe da primeira diagonal até o canto superior
      direito da tela. Fica por baixo do painel da marca, então só aparece do
      lado claro, e as três faces se encontram num ponto da primeira diagonal.
      A quebra passa por trás do formulário, por isso ele fica num cartão. %>
  <div class="hidden lg:block absolute inset-0 bg-marca-300 [clip-path:polygon(41%_100%,100%_0,100%_100%)]"></div>

  <%# Fundo do painel da marca, com a borda em diagonal na mesma inclinação das
      formas do símbolo, e o símbolo em contorno animado atrás de tudo. O tom
      mais escuro da paleta deixa a luz do contorno aparecer e dá contraste
      folgado ao texto branco (7,7:1). %>
  <div class="hidden lg:block absolute inset-y-0 left-0 w-1/2 xl:w-[55%] overflow-hidden bg-marca-700 [clip-path:polygon(0_0,65%_0,100%_100%,0_100%)]">
    <%= render "shared/logo_contorno",
               classe: "pointer-events-none absolute left-[48%] top-1/2 h-[86%] w-auto -translate-x-1/2 -translate-y-1/2" %>
  </div>

  <section class="relative hidden lg:flex flex-col justify-between p-12 text-white">
    <%= render "shared/logo", classe: "h-12 w-auto self-start text-marca-100" %>

    <div class="max-w-sm">
      <%= render "shared/logo", versao: :nome, classe: "h-14 w-auto" %>
      <p class="mt-4 text-sm uppercase tracking-widest text-marca-100">Central de Formulários Clínicos</p>
      <p class="mt-6 text-[15px] leading-relaxed text-marca-100">
        Notificações registradas, acompanhadas e encerradas em um único espaço seguro.
      </p>

      <ul class="mt-10 flex flex-col gap-4">
        <% Formulario.todos.each do |formulario| %>
          <li>
            <p class="text-xs font-semibold uppercase tracking-widest"><%= formulario.titulo %></p>
            <p class="mt-1 text-sm text-marca-100"><%= formulario.descricao %></p>
          </li>
        <% end %>
      </ul>
    </div>

    <p class="text-xs text-marca-100">Acesso restrito a profissionais autorizados.</p>
  </section>

  <main class="relative flex min-h-screen items-center justify-center px-6 py-12">
    <div class="w-full max-w-sm">
      <%# Celular: símbolo e nome juntos, lidos como uma imagem só %>
      <div class="lg:hidden mb-10 flex items-center gap-3" role="img" aria-label="Prisma">
        <%= render "shared/logo", classe: "h-12 w-auto text-marca-500" %>
        <span class="flex flex-col gap-1.5">
          <%= render "shared/logo", versao: :nome, classe: "h-5 w-auto self-start text-marca-700" %>
          <span class="text-[10px] uppercase tracking-widest text-slate-600">Formulários clínicos</span>
        </span>
      </div>

      <div class="border border-marca-200 bg-white p-6 shadow-sm sm:p-8">
        <h1 class="text-2xl font-bold text-slate-900">Entrar</h1>
        <p class="mt-1 text-sm text-slate-600">Use seu CPF ou nome de usuário.</p>

        <div class="mt-8">
          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
            <div>
              <%= f.label :login, "CPF ou nome de usuário", class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
              <%= f.text_field :login, autofocus: true, autocomplete: "off", placeholder: "Informe seu CPF",
                                       class: "#{ApplicationHelper::CAMPO} h-12 placeholder:text-slate-500" %>
            </div>

            <div>
              <%= f.label :password, "Senha", class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
              <%= f.password_field :password, autocomplete: "current-password", class: "#{ApplicationHelper::CAMPO} h-12" %>
            </div>

            <%= f.submit "Entrar", class: "#{ApplicationHelper::BOTAO_PRIMARIO} h-12 w-full uppercase tracking-wide" %>
          <% end %>
        </div>

        <p class="mt-8 border-t border-marca-200 pt-6 text-sm text-slate-600">
          Algum problema para entrar? Abra chamado com a TI.
        </p>
      </div>
    </div>
  </main>
</div>
