<% content_for :title, "Novo usuário · Configurações · Prisma" %>
<% trilha ["Configurações", configuracoes_instituicoes_path], ["Usuários", configuracoes_usuarios_path], ["Novo usuário"] %>

<%= render "lista" %>
<% modal "Novo usuário", descricao: "Depois de cadastrar, defina o que a pessoa pode acessar.",
                         fechar: configuracoes_usuarios_path do %>
  <%= render "formulario", usuario: @usuario %>
<% end %>
