<% content_for :title, "Editar usuário · Configurações · Prisma" %>
<% trilha ["Configurações", configuracoes_instituicoes_path], ["Usuários", configuracoes_usuarios_path], ["Editar #{@usuario.nome_was}"] %>

<%= render "lista" %>
<% modal "Editar usuário", fechar: configuracoes_usuarios_path,
         descricao: ("A conta admin é única: não se desativa, e a senha é trocada pela própria pessoa." if @usuario.admin?) do %>
  <%# Atalhos para as liberações e a senha temporária, antes dos botões do formulário %>
  <% if policy(@usuario).liberar? %>
    <% content_for :mais_opcoes do %>
      <%= grupo_de_opcoes "Acesso e senha" do %>
        <%= linha_de_navegacao "Liberações", edit_configuracoes_usuario_liberacoes_path(@usuario),
                               subtitulo: "Em quais instituições, setores e formulários a pessoa entra." %>
        <%= linha_de_navegacao "Senha temporária", edit_configuracoes_usuario_senha_path(@usuario),
                               subtitulo: "Para quem esqueceu a senha ou foi bloqueado. É trocada no próximo acesso." %>
      <% end %>
    <% end %>
  <% end %>

  <%= render "formulario", usuario: @usuario %>
<% end %>
