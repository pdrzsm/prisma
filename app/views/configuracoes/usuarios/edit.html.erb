<% content_for :title, "Editar usuário · Configurações · Prisma" %>
<% trilha ["Configurações", configuracoes_instituicoes_path], ["Usuários", configuracoes_usuarios_path], ["Editar #{@usuario.nome_was}"] %>
<div>
  <h1 class="text-2xl font-bold text-slate-900">Editar usuário</h1>
  <% if @usuario.admin? %>
    <p class="text-sm text-slate-600">A conta admin é única: não se desativa, e a senha é trocada pela própria pessoa.</p>
  <% end %>
</div>

<%= render "formulario", usuario: @usuario %>

<% if policy(@usuario).liberar? %>
  <section class="max-w-2xl space-y-3 rounded-xl border border-marca-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900">Acesso e senha</h2>
    <p class="text-sm text-slate-600">
      As liberações dizem em quais instituições, setores e formulários a pessoa entra. A senha temporária
      serve para quem esqueceu a senha ou foi bloqueado: ela é trocada no próximo acesso.
    </p>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Liberações", edit_configuracoes_usuario_liberacoes_path(@usuario), class: ApplicationHelper::BOTAO_SECUNDARIO %>
      <%= link_to "Definir senha temporária", edit_configuracoes_usuario_senha_path(@usuario), class: ApplicationHelper::BOTAO_SECUNDARIO %>
    </div>
  </section>
<% end %>
