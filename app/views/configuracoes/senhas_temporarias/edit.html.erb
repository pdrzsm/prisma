<% content_for :title, "Senha temporária · Configurações · Prisma" %>
<% trilha ["Configurações", configuracoes_instituicoes_path], ["Usuários", configuracoes_usuarios_path],
          [@usuario.nome, edit_configuracoes_usuario_path(@usuario)], ["Senha temporária"] %>
<div>
  <h1 class="text-2xl font-bold text-slate-900">Senha temporária</h1>
  <p class="text-sm text-slate-600">
    Para <%= @usuario.nome %>. No próximo acesso, a pessoa vai ter de trocá-la por uma só dela; as sessões
    abertas caem, e uma conta bloqueada é desbloqueada.
  </p>
</div>

<%= form_with model: @usuario, scope: :usuario, url: configuracoes_usuario_senha_path(@usuario), method: :patch, class: "space-y-6" do |form| %>
  <section class="max-w-2xl space-y-5 rounded-xl border border-marca-200 bg-white p-6 shadow-sm">
    <%= render "shared/campo", form:, atributo: :password, rotulo: "Senha temporária", tipo: :senha, autocomplete: "new-password",
               ajuda: "No mínimo #{Devise.password_length.min} caracteres." %>
    <%= render "shared/campo", form:, atributo: :password_confirmation, rotulo: "Repita a senha temporária", tipo: :senha, autocomplete: "new-password" %>
  </section>

  <div class="flex max-w-2xl flex-wrap items-center gap-3">
    <%= form.submit "Definir senha temporária", class: ApplicationHelper::BOTAO_PRIMARIO %>
    <%= link_to "Cancelar", edit_configuracoes_usuario_path(@usuario), class: ApplicationHelper::BOTAO_SECUNDARIO %>
  </div>
<% end %>
