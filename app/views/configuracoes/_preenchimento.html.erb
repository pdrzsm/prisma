<%# locals: (definicao:) %>
<%# Como o formulário aparece para quem preenche (prévia do rascunho e
    consulta de uma versão publicada). Os campos funcionam, inclusive as
    perguntas que aparecem conforme a resposta, mas não há formulário em volta:
    nada é enviado nem gravado. %>
<%= render "avaliacoes_clinicas/finalidade", finalidade: definicao.finalidade.presence || "(finalidade ainda não preenchida)",
                                             base_legal: definicao.base_legal.presence || "(base legal ainda não preenchida)" %>

<section class="bg-white rounded-xl border border-marca-200 shadow-sm p-6 flex flex-col gap-6">
  <h2 class="text-lg font-bold text-slate-900">Identificação do paciente</h2>
  <% Paciente::IDENTIFICACAO.each do |pergunta| %>
    <%= render "avaliacoes_clinicas/pergunta", definicao: nil, pergunta:, nome: "paciente[#{pergunta.chave}]", valor: nil, erros: [] %>
  <% end %>
</section>

<%= render "avaliacoes_clinicas/secoes", definicao:, avaliacao: AvaliacaoClinica.new %>
