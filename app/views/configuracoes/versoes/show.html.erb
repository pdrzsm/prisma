<% content_for :title, "Versão #{@versao.numero} · #{@definicao.titulo} · Gerador de formulários · Prisma" %>
<% trilha ["Configurações", configuracoes_instituicoes_path], ["Gerador de formulários", configuracoes_formularios_path],
          [@formulario.titulo, configuracoes_formulario_path(@formulario)], ["Versão #{@versao.numero}"] %>
<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Versão <%= @versao.numero %> · <%= @definicao.titulo %></h1>
    <p class="max-w-3xl text-sm text-slate-600">
      Publicada em <%= data_e_hora(@versao.publicada_em) %> por
      <%= @versao.publicada_por ? "@#{@versao.publicada_por.username}" : "migração do sistema" %>.
      <%= pluralize(@notificacoes, "notificação segue", plural: "notificações seguem") %> esta versão. Uma versão publicada não muda.
    </p>
  </div>
  <%= link_to "Voltar", configuracoes_formulario_path(@formulario), class: ApplicationHelper::BOTAO_SECUNDARIO %>
</div>

<% if @definicao.descricao %>
  <p class="max-w-3xl whitespace-pre-line text-sm text-slate-600"><%= @definicao.descricao %></p>
<% end %>
<%= render "configuracoes/preenchimento", definicao: @definicao %>
