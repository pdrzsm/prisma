<%# A lista dos formulários: a tela da lista e o fundo do modal de criação. %>
<% selo = "inline-flex whitespace-nowrap px-2 py-0.5 text-xs font-semibold" %>

<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
  <p class="max-w-2xl text-sm text-slate-600">
    Cada formulário é montado num rascunho e só aparece para quem preenche depois de publicado. Uma versão
    publicada nunca muda: cada notificação continua com as perguntas da versão em que foi registrada.
  </p>
  <%= link_to com_icone(:mais, "Novo formulário"), new_configuracoes_formulario_path, class: "#{ApplicationHelper::BOTAO_PRIMARIO} h-10" %>
</div>

<% if @formularios.empty? %>
  <div class="rounded-xl border border-marca-200 bg-white p-8 text-center text-sm text-slate-600">
    Nenhum formulário ainda. Crie o primeiro, numa instituição com setores.
  </div>
<% else %>
  <%# relative: segura dentro da rolagem o "Ações" só para leitores de tela (sr-only é absolute) %>
  <div class="relative overflow-x-auto rounded-xl border border-marca-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-marca-200 text-sm">
      <thead class="bg-marca-50 text-left text-xs font-semibold uppercase tracking-wider text-slate-600">
        <tr>
          <th scope="col" class="px-4 py-3">Formulário</th>
          <th scope="col" class="px-4 py-3">Instituição</th>
          <th scope="col" class="px-4 py-3">Situação</th>
          <th scope="col" class="px-4 py-3">Setores</th>
          <th scope="col" class="px-4 py-3">Notificações</th>
          <th scope="col" class="px-4 py-3"><span class="sr-only">Ações</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @formularios.each do |formulario| %>
          <tr class="hover:bg-marca-50/60">
            <td class="px-4 py-3">
              <p class="font-semibold text-slate-900"><%= formulario.titulo %></p>
              <p class="text-xs text-slate-500"><%= formulario.chave %></p>
            </td>
            <td class="px-4 py-3 text-slate-700"><%= formulario.instituicao.sigla || formulario.instituicao.nome %></td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap gap-1">
                <% if formulario.publicado? %>
                  <span class="<%= selo %> bg-emerald-50 text-emerald-700"><%= com_icone :ok, "Publicado · versão #{formulario.versao_publicada.numero}" %></span>
                <% else %>
                  <span class="<%= selo %> bg-slate-100 text-slate-700"><%= com_icone :circulo, "Nunca publicado" %></span>
                <% end %>
                <% if formulario.rascunho %>
                  <span class="<%= selo %> bg-amber-50 text-amber-700"><%= com_icone :lapis, "Rascunho da versão #{formulario.rascunho.numero}" %></span>
                <% end %>
              </div>
            </td>
            <td class="px-4 py-3 text-slate-700"><%= @setores.fetch(formulario.chave, 0) %></td>
            <td class="px-4 py-3 text-slate-700"><%= @notificacoes.fetch(formulario.chave, 0) %></td>
            <td class="px-4 py-3 whitespace-nowrap text-right">
              <%= link_to "Abrir", configuracoes_formulario_path(formulario), class: "font-semibold text-marca-700 hover:underline",
                                   aria: { label: "Abrir #{formulario.titulo}" } %>
              <%# Sem nenhuma notificação, o formulário pode ser excluído, publicado ou não (a tela seguinte confirma) %>
              <% if @notificacoes.fetch(formulario.chave, 0).zero? %>
                <%= link_to "Excluir", excluir_configuracoes_formulario_path(formulario), class: "ml-3 font-semibold text-rose-700 hover:underline",
                                       aria: { label: "Excluir #{formulario.titulo}" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
