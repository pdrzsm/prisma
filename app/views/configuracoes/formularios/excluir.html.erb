<% content_for :title, "Excluir formulário · Configurações · Prisma" %>
<% trilha ["Configurações", configuracoes_instituicoes_path], ["Gerador de formulários", configuracoes_formularios_path],
          [@formulario.titulo, configuracoes_formulario_path(@formulario)], ["Excluir"] %>
<% cartao = "max-w-2xl rounded-xl border border-marca-200 bg-white p-5 shadow-sm sm:p-6" %>
<div>
  <h1 class="text-2xl font-bold text-slate-900">Excluir “<%= @formulario.titulo %>”?</h1>
  <p class="max-w-2xl text-sm text-slate-600">
    Nenhuma notificação foi registrada com este formulário, então nenhum registro clínico se perde. Não dá para
    desfazer: as perguntas dele não ficam guardadas em lugar nenhum. Quem excluiu e quando ficam na auditoria.
  </p>
</div>

<%= render "configuracoes/erros", erros: @erros, titulo: "Não foi possível excluir" %>

<section class="<%= cartao %>" aria-labelledby="titulo-o-que-sai">
  <h2 id="titulo-o-que-sai" class="text-lg font-bold text-slate-900">O que sai junto</h2>
  <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-700">
    <% @versoes.each do |versao| %>
      <li>
        <% if versao.publicada? %>
          A versão <%= versao.numero %>, publicada em <%= data_e_hora(versao.publicada_em) %>
          por <%= versao.publicada_por ? "@#{versao.publicada_por.username}" : "migração do sistema" %>.
        <% else %>
          O rascunho da versão <%= versao.numero %>.
        <% end %>
      </li>
    <% end %>
    <li>
      <% if @setores_que_saem.any? %>
        A habilitação em <%= @setores_que_saem.map(&:nome_completo).to_sentence %>.
      <% else %>
        Nenhum setor o tem habilitado.
      <% end %>
    </li>
    <li>
      <% if @liberacoes.positive? %>
        <%= pluralize(@liberacoes, "liberação", plural: "liberações") %> de pessoas neste formulário
        (quem as tinha deixa de vê-lo).
      <% else %>
        Nenhuma pessoa está liberada nele.
      <% end %>
    </li>
  </ul>
</section>

<%= form_with url: configuracoes_formulario_path(@formulario), method: :delete, class: "max-w-2xl space-y-4" do %>
  <% if @formulario.publicado? %>
    <label for="confirmo" class="flex items-start gap-2 text-sm text-slate-800">
      <%= check_box_tag :confirmo, "1", false, id: "confirmo", class: "mt-0.5 accent-marca-600", aria: { invalid: @erros.present? } %>
      <span>Entendi que este formulário já foi publicado e que ele e as perguntas dele não poderão ser recuperados.</span>
    </label>
  <% end %>
  <div class="flex flex-wrap gap-3">
    <%= submit_tag "Excluir formulário", class: ApplicationHelper::BOTAO_PERIGO %>
    <%= link_to "Cancelar", configuracoes_formulario_path(@formulario), class: ApplicationHelper::BOTAO_SECUNDARIO %>
  </div>
<% end %>
