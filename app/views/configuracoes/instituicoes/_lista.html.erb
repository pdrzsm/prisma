<%# A lista de instituições, numa lista só, cada uma com os setores recuados embaixo. É a
    tela da lista e o fundo dos modais de instituição e de setor. %>
<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
  <p class="max-w-2xl text-sm text-slate-600">
    Só o admin vê esta área. Cadastre as instituições e, dentro de cada uma, os setores.
  </p>
  <%= link_to com_icone(:mais, "Nova instituição"), new_configuracoes_instituicao_path, class: "#{ApplicationHelper::BOTAO_PRIMARIO} h-10" %>
</div>

<% if @instituicoes.empty? %>
  <div class="rounded-xl border border-marca-200 bg-white p-8 text-center text-sm text-slate-600">
    Nenhuma instituição cadastrada ainda.
  </div>
<% else %>
  <%= grupo_de_opcoes lista: true, classe: "max-w-3xl" do %>
    <% @instituicoes.each do |instituicao| %>
      <%# O id é a âncora para onde a tela volta depois de salvar %>
      <li id="<%= dom_id(instituicao) %>">
        <ul class="divide-y divide-marca-100">
          <li class="bg-marca-50/50">
            <%= linha_de_navegacao instituicao.nome, edit_configuracoes_instituicao_path(instituicao),
                  subtitulo: [ instituicao.sigla, pluralize(instituicao.setores.size, "setor", "setores") ].compact.join(" · "),
                  aria: { label: "Editar #{instituicao.nome}" } %>
          </li>
          <% instituicao.setores.each do |setor| %>
            <li>
              <%= linha_de_navegacao setor.nome, edit_configuracoes_instituicao_setor_path(instituicao, setor),
                                     recuada: true, aria: { label: "Editar setor #{setor.nome} de #{instituicao.nome}" } %>
            </li>
          <% end %>
          <li>
            <%= link_to com_icone(:mais, "Novo setor"), new_configuracoes_instituicao_setor_path(instituicao),
                        class: "block py-2 pl-8 pr-4 text-sm font-semibold text-marca-700 hover:bg-marca-50 hover:underline sm:pl-10 sm:pr-5",
                        aria: { label: "Novo setor em #{instituicao.nome}" } %>
          </li>
        </ul>
      </li>
    <% end %>
  <% end %>
<% end %>
