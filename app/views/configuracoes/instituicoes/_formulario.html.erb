<%# locals: (instituicao:) %>
<%= form_with model: [ :configuracoes, instituicao ], class: "space-y-6" do |form| %>
  <section class="max-w-2xl space-y-5 rounded-xl border border-marca-200 bg-white p-6 shadow-sm">
    <%= render "shared/campo", form:, atributo: :nome, rotulo: "Nome", maximo: 150,
               ajuda: "O nome completo, como a instituição é conhecida." %>
    <%= render "shared/campo", form:, atributo: :sigla, rotulo: "Sigla (opcional)", maximo: 20,
               ajuda: "Forma curta do nome, em maiúsculas. Não pode repetir." %>
  </section>

  <div class="flex max-w-2xl flex-wrap items-center gap-3">
    <%= form.submit instituicao.persisted? ? "Salvar alterações" : "Cadastrar instituição", class: ApplicationHelper::BOTAO_PRIMARIO %>
    <%= link_to "Cancelar", configuracoes_instituicoes_path, class: ApplicationHelper::BOTAO_SECUNDARIO %>
    <%# Na edição, o Excluir fica na ponta direita desta linha (ver edit.html.erb) %>
    <% if content_for?(:excluir) %>
      <div class="ms-auto"><%= yield :excluir %></div>
    <% end %>
  </div>
<% end %>
