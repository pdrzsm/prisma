<%# locals: (setor:) %>
<%= form_with model: [ :configuracoes, setor.instituicao, setor ], class: "space-y-6" do |form| %>
  <section class="max-w-2xl space-y-5 rounded-xl border border-marca-200 bg-white p-6 shadow-sm">
    <%= render "configuracoes/campo", form:, atributo: :nome, rotulo: "Nome do setor", maximo: 150,
               ajuda: "Pode repetir o nome de um setor de outra instituição, não desta." %>
  </section>

  <div class="flex max-w-2xl flex-wrap items-center gap-3">
    <%= form.submit setor.persisted? ? "Salvar alterações" : "Cadastrar setor", class: ApplicationHelper::BOTAO_PRIMARIO %>
    <%= link_to "Cancelar", configuracoes_instituicoes_path(anchor: dom_id(setor.instituicao)), class: ApplicationHelper::BOTAO_SECUNDARIO %>
    <%# Na edição, o Excluir fica na ponta direita desta linha (ver edit.html.erb) %>
    <% if content_for?(:excluir) %>
      <div class="ms-auto"><%= yield :excluir %></div>
    <% end %>
  </div>
<% end %>
