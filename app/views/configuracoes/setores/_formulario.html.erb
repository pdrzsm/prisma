<%# locals: (setor:) %>
<%= form_with model: [ :configuracoes, setor.instituicao, setor ], class: "space-y-6" do |form| %>
  <section class="max-w-2xl space-y-5 rounded-xl border border-marca-200 bg-white p-6 shadow-sm">
    <%= render "shared/campo", form:, atributo: :nome, rotulo: "Nome do setor", maximo: 150,
               ajuda: "Pode repetir o nome de um setor de outra instituição, não desta." %>

    <%# Formulários habilitados: só eles podem ser liberados para alguém e
        receber notificações neste setor. O campo escondido manda a lista vazia
        quando tudo é desmarcado. %>
    <fieldset class="space-y-2">
      <legend class="text-sm font-semibold text-slate-900">Formulários deste setor</legend>
      <%= hidden_field_tag "setor[formularios][]", "", id: nil %>
      <% habilitados = setor.persisted? ? setor.formularios : Array(params.dig(:setor, :formularios)) %>
      <% Formulario.todos.each do |formulario| %>
        <% id = "setor_formulario_#{formulario.chave}" %>
        <label for="<%= id %>" class="flex items-start gap-2 text-sm">
          <%= check_box_tag "setor[formularios][]", formulario.chave, habilitados.include?(formulario.chave),
                            id:, class: "mt-0.5 h-4 w-4 accent-marca-600" %>
          <span>
            <%= formulario.titulo %>
            <% if setor.persisted? && setor.avaliacoes_clinicas.exists?(formulario: formulario.chave) %>
              <span class="block text-xs text-slate-600">Tem notificações neste setor: não pode ser desabilitado.</span>
            <% end %>
          </span>
        </label>
      <% end %>
      <p class="text-xs text-slate-600">Desabilitar um formulário tira também as liberações dele neste setor.</p>
    </fieldset>
  </section>

  <div class="flex max-w-2xl flex-wrap items-center gap-3">
    <%= form.submit setor.persisted? ? "Salvar alterações" : "Cadastrar setor", class: ApplicationHelper::BOTAO_PRIMARIO %>
    <%= link_to "Cancelar", configuracoes_instituicoes_path(anchor: dom_id(setor.instituicao)), class: ApplicationHelper::BOTAO_SECUNDARIO %>
    <%# Na edição, o Excluir fica na ponta direita desta linha (ver edit.html.erb) %>
    <% if content_for?(:excluir) %>
      <div class="ms-auto"><%= yield :excluir %></div>
    <% end %>
  </div>
<% end %>
