<%# locals: (setor:) %>
<%= form_with model: [ :configuracoes, setor.instituicao, setor ], class: "space-y-6" do |form| %>
  <%= grupo_de_opcoes do %>
    <%= linha_de_campo do %>
      <%= render "shared/campo", form:, atributo: :nome, rotulo: "Nome do setor", maximo: 150,
                 ajuda: "Pode repetir o nome de um setor de outra instituição, não desta." %>
    <% end %>
  <% end %>

  <%# Formulários habilitados: só eles podem ser liberados para alguém e
      receber notificações neste setor. Só os da instituição do setor (e um de
      outra que já estava aqui antes da regra de uma instituição só). O campo
      escondido manda a lista vazia quando tudo é desligado. %>
  <%= hidden_field_tag "setor[formularios][]", "", id: nil %>
  <% habilitados = setor.persisted? ? setor.formularios : Array(params.dig(:setor, :formularios)) %>
  <% formularios = setor.formularios_disponiveis | Formulario.where(chave: setor.formularios).includes(:versao_publicada, :rascunho).to_a %>
  <%= grupo_de_opcoes "Formulários deste setor", id: "formularios_do_setor",
        descricao: "Os formulários de #{setor.instituicao.nome}. Só os habilitados podem ser liberados para alguém e " \
                   "receber notificações aqui. Desabilitar um formulário tira também as liberações dele neste setor." do %>
    <% formularios.each do |formulario| %>
      <% com_notificacoes = setor.persisted? && setor.avaliacoes_clinicas.exists?(formulario: formulario.chave) %>
      <% subtitulo = [ ("Rascunho: passa a valer quando for publicado." unless formulario.publicado?),
                       ("De outra instituição, de antes da regra de uma instituição só." if formulario.instituicao_id != setor.instituicao_id),
                       ("Tem notificações neste setor: não pode ser desabilitado." if com_notificacoes) ].compact.join(" ") %>
      <%= linha_com_interruptor formulario.titulo, id: "setor_formulario_#{formulario.chave}", subtitulo: subtitulo.presence do |opcoes| %>
        <%= check_box_tag "setor[formularios][]", formulario.chave, habilitados.include?(formulario.chave), opcoes %>
      <% end %>
    <% end %>
    <% if formularios.empty? %>
      <p class="px-4 py-3 text-sm text-slate-600 sm:px-5">
        Nenhum formulário desta instituição ainda. Crie no
        <%= link_to "Gerador de formulários", configuracoes_formularios_path, class: "font-semibold text-marca-700 hover:underline" %>.
      </p>
    <% end %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit setor.persisted? ? "Salvar alterações" : "Cadastrar setor", class: ApplicationHelper::BOTAO_PRIMARIO %>
    <%= link_to "Cancelar", configuracoes_instituicoes_path(anchor: dom_id(setor.instituicao)), class: ApplicationHelper::BOTAO_SECUNDARIO %>
    <%# Na edição, o Excluir fica na ponta direita desta linha (ver edit.html.erb) %>
    <% if content_for?(:excluir) %>
      <div class="ms-auto"><%= yield :excluir %></div>
    <% end %>
  </div>
<% end %>
