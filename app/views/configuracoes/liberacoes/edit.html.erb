<% content_for :title, "Liberações · Configurações · Prisma" %>
<% trilha ["Configurações", configuracoes_instituicoes_path], ["Usuários", configuracoes_usuarios_path],
          [@usuario.nome, edit_configuracoes_usuario_path(@usuario)], ["Liberações"] %>
<div>
  <h1 class="text-2xl font-bold text-slate-900">Liberações de <%= @usuario.nome %></h1>
  <p class="max-w-3xl text-sm text-slate-600">
    A pessoa só usa um formulário num setor com as três liberações: a instituição, o setor e o
    formulário. Nada é herdado: desligar um nível tira o acesso a tudo o que está dentro dele.
  </p>
</div>

<%# O estado inteiro vai de uma vez; LiberacoesDoUsuario acerta o banco. O campo
    escondido garante o envio mesmo com tudo desligado (para tirar todo acesso).
    Cada instituição é um grupo (OpcoesHelper): a instituição e os setores com
    interruptor, e cada formulário com o papel em segmentos. Estilo de
    "desligado" dos níveis de baixo: .liberacao em application.css. %>
<%= form_with url: configuracoes_usuario_liberacoes_path(@usuario), method: :patch, class: "space-y-6" do %>
  <%= hidden_field_tag "liberacoes[instituicoes][]", "", id: nil %>

  <% if @instituicoes.empty? %>
    <div class="rounded-xl border border-marca-200 bg-white p-8 text-center text-sm text-slate-600">
      Nenhuma instituição cadastrada. Cadastre em <%= link_to "Instituições e setores", configuracoes_instituicoes_path, class: "font-semibold text-marca-700 hover:underline" %>.
    </div>
  <% end %>

  <% papeis = [ [ "", "Sem acesso" ], [ "consulta", "Só consulta" ], [ "registra", "Registra" ] ] %>
  <% @instituicoes.each do |instituicao| %>
    <%# Os títulos das linhas se repetem entre instituições ("Acesso à
        instituição", setores de mesmo nome): o leitor de tela lê junto o
        título do grupo (contexto:) %>
    <% grupo = dom_id(instituicao, :liberacoes) %>
    <%= grupo_de_opcoes instituicao.nome, id: grupo, classe: "max-w-3xl",
          descricao: (tag.span(instituicao.sigla, class: "text-xs font-semibold uppercase tracking-widest text-marca-700") if instituicao.sigla) do %>
      <div class="liberacao divide-y divide-marca-100">
        <%= linha_com_interruptor "Acesso à instituição", id: dom_id(instituicao, :liberacao), contexto: "#{grupo}_titulo",
              subtitulo: "Desligado, nada desta instituição vale, nem os setores ligados." do |opcoes| %>
          <%= check_box_tag "liberacoes[instituicoes][]", instituicao.id, @liberadas[:instituicoes].include?(instituicao.id), opcoes %>
        <% end %>

        <div class="liberacao-dentro divide-y divide-marca-100">
          <% if instituicao.setores.empty? %>
            <p class="px-4 py-3 text-sm text-slate-600 sm:px-5">Nenhum setor nesta instituição.</p>
          <% end %>

          <% instituicao.setores.each do |setor| %>
            <% linha_do_setor = dom_id(setor, :liberacao) %>
            <div class="liberacao">
              <%= linha_com_interruptor "Setor #{setor.nome}", id: linha_do_setor, contexto: "#{grupo}_titulo" do |opcoes| %>
                <%= check_box_tag "liberacoes[setores][]", setor.id, @liberadas[:setores].include?(setor.id), opcoes %>
              <% end %>

              <div class="liberacao-dentro pb-2">
                <%# Só os publicados: um rascunho já pode estar habilitado no setor %>
                <% publicados = setor.formularios.filter_map { |chave| @formularios[chave] } %>
                <% if publicados.empty? %>
                  <p class="pb-2 pl-8 pr-4 text-sm text-slate-600 sm:pl-10">Nenhum formulário publicado habilitado neste setor.</p>
                <% end %>

                <% publicados.each do |formulario| %>
                  <% chave = formulario.chave %>
                  <%= linha_com_segmentos formulario.titulo, id: "liberacao_#{setor.id}_#{chave}", recuada: true,
                        nome: "liberacoes[formularios][#{setor.id}][#{chave}]", opcoes: papeis,
                        marcado: @liberadas[:formularios][[ setor.id, chave ]],
                        contexto: "#{linha_do_setor}_titulo #{grupo}_titulo" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="flex max-w-2xl flex-wrap items-center gap-3">
    <%= submit_tag "Salvar liberações", class: ApplicationHelper::BOTAO_PRIMARIO %>
    <%= link_to "Cancelar", configuracoes_usuarios_path, class: ApplicationHelper::BOTAO_SECUNDARIO %>
  </div>
<% end %>
