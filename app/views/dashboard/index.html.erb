<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Visão geral</h1>
    <p class="text-sm text-slate-600">Resumo dos registros clínicos.</p>
  </div>
  <%= link_to "Abrir formulários", formularios_path, class: ApplicationHelper::BOTAO_PRIMARIO %>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Registros no total</p>
    <p class="text-3xl font-extrabold text-slate-900 mt-2"><%= @total %></p>
  </div>

  <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Registrados hoje</p>
    <p class="text-3xl font-extrabold text-slate-900 mt-2"><%= @registrados_hoje %></p>
  </div>

  <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Proteção dos dados</p>
    <p class="text-sm font-semibold text-emerald-600 mt-3 flex items-center">
      <span class="h-2 w-2 rounded-full bg-emerald-500 inline-block mr-2"></span>
      Ativa
    </p>
    <p class="text-xs text-slate-500 mt-1">Dados cifrados no banco e toda alteração registrada.</p>
  </div>
</div>
