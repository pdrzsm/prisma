<div class="min-h-screen bg-slate-50 text-slate-800">
  <!-- Topbar -->
  <header class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between shadow-sm">
    <div class="flex items-center space-x-3">
      <div class="h-9 w-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow">
        P
      </div>
      <div>
        <h1 class="text-xl font-bold tracking-tight text-slate-900 leading-none">Prisma</h1>
        <span class="text-xs text-slate-500 font-medium">Central de Formulários Clínicos</span>
      </div>
    </div>

    <!-- Perfil e Logout -->
      <div class="flex items-center space-x-4">
        <div class="text-right">
          <p class="text-sm font-semibold text-slate-900 leading-none">@<%= current_user.username %></p>
        </div>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-indigo-100 text-indigo-800 uppercase">
          <%= current_user.role %>
        </span>
        <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "px-3 py-1.5 text-xs font-semibold text-rose-600 hover:text-rose-700 hover:bg-rose-50 border border-rose-200 rounded-lg transition" %>
      </div>
  </header>

  <!-- Conteúdo Principal -->
  <main class="max-w-6xl mx-auto p-6 md:p-8 space-y-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Visão Geral</h2>
        <p class="text-sm text-slate-600">Ambiente pronto para recepção e triagem de atendimentos.</p>
      </div>
      <%# Só aparece para quem a policy deixa registrar (consultor não vê) %>
      <% if policy(AvaliacaoClinica).create? %>
        <%= link_to "+ Novo Formulário de Entrada", new_avaliacao_clinica_path,
                    class: "px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm rounded-lg shadow-sm transition" %>
      <% end %>
    </div>

    <!-- Cards de Resumo -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Formulários Pendentes</p>
        <p class="text-3xl font-extrabold text-slate-900 mt-2">0</p>
      </div>

      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Pacientes Triados Hoje</p>
        <p class="text-3xl font-extrabold text-slate-900 mt-2">0</p>
      </div>

      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Criptografia & Auditoria</p>
        <p class="text-sm font-semibold text-emerald-600 mt-3 flex items-center">
          <span class="h-2 w-2 rounded-full bg-emerald-500 inline-block mr-2"></span>
          Ativo (ActiveRecord + PaperTrail)
        </p>
      </div>
    </div>
  </main>
</div>