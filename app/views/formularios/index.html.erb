<% content_for :title, "Formulários · Prisma" %>
<% trilha ["Formulários"] %>
<h1 class="sr-only">Formulários</h1>

<% if @unidades.empty? %>
  <div class="border border-marca-200 bg-white p-8 text-center text-sm text-slate-600">
    Você ainda não tem nenhum formulário liberado. Fale com a administração do sistema.
  </div>
<% else %>
  <%# Dois menus em ciclo: a unidade e, dentro dela, a base. Trocar a unidade
      mantém a base se ela existir lá; senão volta à primeira. %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
    <%= render "formularios/menu_suspenso", id: "unidade", rotulo: "1. Unidade", simbolo: :predio, atual: @unidade.nome_completo,
          opcoes: @unidades.map { |setor, bases|
            base = bases.map(&:first).find { |formulario, _| formulario.chave == @base.chave }
            [ setor.nome_completo, formularios_path(unidade: setor.id, formulario: base&.chave), setor == @unidade ] } %>
    <%= render "formularios/menu_suspenso", id: "base", rotulo: "2. Formulário", simbolo: :documento, atual: @base.titulo,
          opcoes: @bases.map { |formulario, _| [ formulario.titulo, formularios_path(unidade: @unidade.id, formulario: formulario.chave), formulario == @base ] } %>
    <div class="flex items-center gap-3 sm:ml-auto">
      <%# Filtro discreto: abre o painel lateral (?filtros=1), com o prontuário %>
      <% base_da_lista = { unidade: @unidade.id, formulario: @base.chave, prontuario: params[:prontuario].presence } %>
      <%= link_to formularios_path(**base_da_lista, filtros: 1), title: "Filtros", aria: { label: "Filtros#{" (em uso)" if params[:prontuario].present?}" },
                  class: "#{ApplicationHelper::BOTAO_SECUNDARIO} h-10 gap-2 px-3" do %>
        <%= icone :filtro %><span class="hidden sm:inline">Filtros</span><% if params[:prontuario].present? %><span class="h-2 w-2 bg-marca-600" aria-hidden="true"></span><% end %>
      <% end %>
      <% if params[:prontuario].present? %>
        <%= link_to "Limpar", formularios_path(unidade: @unidade.id, formulario: @base.chave), class: "#{ApplicationHelper::BOTAO_SECUNDARIO} h-10" %>
      <% end %>
      <% if @papel == "registra" %>
        <%= link_to com_icone(:mais, "Nova notificação"), new_formulario_avaliacao_clinica_path(@base), class: "#{ApplicationHelper::BOTAO_PRIMARIO} h-10" %>
      <% end %>
    </div>
  </div>

  <section aria-labelledby="registros" class="mt-6 space-y-3">
    <h2 id="registros" class="text-xs font-semibold uppercase tracking-widest text-slate-600">
      <%= @base.titulo %> em <%= @unidade.nome_completo %>
    </h2>
    <% if @avaliacoes.empty? %>
      <div class="border border-marca-200 bg-white p-8 text-center text-sm text-slate-600">
        <% if @paginacao.total.positive? %>
          Não há registros nesta página. <%= link_to "Voltar à primeira página", formularios_path(**base_da_lista), class: "font-semibold text-marca-700 hover:underline" %>
        <% else %>
          <%= params[:prontuario].present? ? "Nenhum registro com esse prontuário." : "Nenhum registro ainda." %>
        <% end %>
      </div>
    <% else %>
      <%# A mesma lista, com os mesmos filtros, na página dada (a primeira não leva o número na URL) %>
      <% caminho = ->(pagina) { formularios_path(**base_da_lista, pagina: (pagina if pagina > 1)) } %>
      <%= render "avaliacoes_clinicas/planilha", formulario: @base, definicao: @base.definicao, avaliacoes: @avaliacoes, autores: @autores,
                                                 varios_setores: false, paginacao: @paginacao, caminho: %>
    <% end %>
  </section>
<% end %>

<% if @base && params[:filtros].present? %>
  <% painel_lateral "Filtros", fechar: formularios_path(**base_da_lista), simbolo: :filtro do %>
    <%= form_with url: formularios_path, method: :get, html: { role: "search" }, class: ModalHelper::PAINEL_FORMULARIO do |busca| %>
      <%= busca.hidden_field :unidade, value: @unidade.id, id: nil %>
      <%= busca.hidden_field :formulario, value: @base.chave, id: nil %>
      <div class="<%= ModalHelper::PAINEL_CORPO %>">
        <div class="space-y-1.5">
          <%= busca.label :prontuario, "Prontuário ou iniciais", class: "block text-xs font-semibold uppercase tracking-wider text-slate-600" %>
          <%= busca.search_field :prontuario, value: params[:prontuario], autocomplete: "off", autofocus: true, placeholder: "Digite parte do prontuário ou as iniciais", list: "sugestoes_de_busca",
                                 class: "block w-full border border-marca-300 bg-marca-50 px-3 py-2 text-sm font-semibold text-slate-700 placeholder:text-slate-500 focus:border-marca-700 focus:outline-none focus:ring-1 focus:ring-marca-700" %>
          <datalist id="sugestoes_de_busca">
            <% Array(@sugestoes).each do |sugestao| %><option value="<%= sugestao %>"></option><% end %>
          </datalist>
          <p class="text-xs text-slate-600">Acha por qualquer parte do prontuário (SAH ou AGHUSE) ou das iniciais; as sugestões vêm dos registros que você vê.</p>
        </div>
      </div>
      <div class="<%= ModalHelper::PAINEL_RODAPE %>">
        <%= link_to "Limpar", formularios_path(unidade: @unidade.id, formulario: @base.chave), class: "#{ApplicationHelper::BOTAO_SECUNDARIO} h-10" %>
        <%= busca.button type: :submit, name: nil, class: "#{ApplicationHelper::BOTAO_PRIMARIO} h-10 gap-2" do %><%= icone :busca %>Aplicar filtros<% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
