<%# Painel lateral das notas de atualização (config/notas_de_atualizacao.yml) %>
<div class="<%= ModalHelper::PAINEL_CORPO %>">
  <% NotasDeAtualizacao.todas.each do |nota| %>
    <section class="border border-marca-200 p-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-600"><%= l(nota.data, format: "%d/%m/%Y") %></p>
      <h2 class="mt-1 text-base font-bold text-slate-900"><%= nota.titulo %></h2>
      <ul class="mt-3 space-y-2 text-sm text-slate-700">
        <% nota.itens.each do |item| %>
          <li class="flex gap-2"><%= icone :ok, classe: "mt-0.5 h-4 w-4 text-marca-600" %><span><%= item %></span></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
