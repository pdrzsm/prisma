<%# Menu do sistema: na barra lateral (desktop) e no menu recolhido (celular).
    Só navegação: todo item é um link para uma tela, e todos começam na mesma
    margem. Conta, avisos, novidades e aparência ficam no cabeçalho
    (shared/_topo). Na barra lateral, que dá ao menu a altura da tela, o
    grupo Configurações desce para o pé (mt-auto); no menu do celular, que não
    tem altura fixa, ele vem logo depois dos outros itens. %>
<nav aria-label="Seções do sistema" class="flex flex-1 flex-col text-sm">
  <ul>
    <li><%= item_do_menu "Visão geral", root_path, icone: :casa, ativo: controller_name == "dashboard" %></li>
  </ul>

  <%# Formulários: a página escolhe a unidade e a base. Sem nenhum acesso, o
      item não aparece %>
  <% if current_user.permissoes.formularios_consultados.any? %>
    <ul>
      <li><%= item_do_menu "Formulários", formularios_path, icone: :formularios,
                           ativo: controller_path.in?(%w[formularios avaliacoes_clinicas identificacoes]) %></li>
      <li><%= item_do_menu "Relatórios", relatorios_path, icone: :grafico, ativo: controller_path == "relatorios" %></li>
    </ul>
  <% end %>

  <%# Configurações: só o admin, no pé do menu. O mt-auto fica neste div e a
      margem mínima (mt-4) no grupo, para os dois não brigarem no mesmo
      elemento: sobrando altura, o grupo vai para baixo; faltando, fica a
      margem do grupo. %>
  <% if policy(Instituicao).index? %>
    <div class="mt-auto">
      <%= grupo_do_menu "Configurações" do %>
        <li><%= item_do_menu "Instituições e setores", configuracoes_instituicoes_path, icone: :predio,
                             ativo: controller_path.in?(%w[configuracoes/instituicoes configuracoes/setores]) %></li>
        <li><%= item_do_menu "Usuários", configuracoes_usuarios_path, icone: :usuarios,
                             ativo: controller_path.in?(%w[configuracoes/usuarios configuracoes/liberacoes configuracoes/senhas_temporarias]) %></li>
        <li><%= item_do_menu "Gerador de formulários", configuracoes_formularios_path, icone: :gerador,
                             ativo: controller_path.in?(%w[configuracoes/formularios configuracoes/rascunhos configuracoes/secoes
                                                            configuracoes/perguntas configuracoes/publicacoes configuracoes/versoes]) %></li>
      <% end %>
    </div>
  <% end %>
</nav>
