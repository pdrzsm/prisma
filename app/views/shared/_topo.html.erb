<header class="bg-white border-b border-slate-200 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
    <%= link_to root_path, class: "flex items-center gap-3" do %>
      <span class="h-9 w-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow">P</span>
      <span>
        <span class="block text-xl font-bold tracking-tight text-slate-900 leading-none">Prisma</span>
        <span class="hidden sm:inline text-xs text-slate-500 font-medium">Central de Formulários Clínicos</span>
      </span>
    <% end %>

    <div class="flex items-center gap-4">
      <p class="hidden sm:block text-sm font-semibold text-slate-900">@<%= current_user.username %></p>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-indigo-100 text-indigo-800 uppercase">
        <%= current_user.role %>
      </span>
      <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "px-3 py-1.5 text-xs font-semibold text-rose-600 hover:text-rose-700 hover:bg-rose-50 border border-rose-200 rounded-lg transition" %>
    </div>
  </div>

  <nav aria-label="Seções do sistema" class="max-w-6xl mx-auto px-4 sm:px-6 flex gap-6">
    <%= aba "Visão geral", root_path, ativa: controller_name == "dashboard" %>
    <%= aba "Formulários", formularios_path, ativa: controller_name.in?(%w[formularios avaliacoes_clinicas]) %>
  </nav>
</header>
