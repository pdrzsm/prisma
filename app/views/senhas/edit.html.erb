<% content_for :title, "Trocar senha · Prisma" %>
<% trilha ["Trocar senha"] %>
<div>
  <h1 class="text-2xl font-bold text-slate-900">Trocar senha</h1>
  <% if current_user.deve_trocar_senha? %>
    <p class="max-w-2xl text-sm text-slate-600">
      Você entrou com uma senha temporária. Para continuar, troque-a por uma senha só sua: ninguém,
      nem a administração, vai saber qual é.
    </p>
  <% end %>
</div>

<%= form_with model: current_user, scope: :usuario, url: senha_path, method: :patch, class: "space-y-6" do |form| %>
  <section class="max-w-2xl space-y-5 rounded-xl border border-marca-200 bg-white p-6 shadow-sm">
    <%= render "shared/campo", form:, atributo: :current_password, tipo: :senha, autocomplete: "current-password",
               rotulo: current_user.deve_trocar_senha? ? "Senha temporária" : "Senha atual" %>
    <%= render "shared/campo", form:, atributo: :password, rotulo: "Nova senha", tipo: :senha, autocomplete: "new-password",
               ajuda: "No mínimo #{Devise.password_length.min} caracteres, diferente da atual." %>
    <%= render "shared/campo", form:, atributo: :password_confirmation, rotulo: "Repita a nova senha", tipo: :senha, autocomplete: "new-password" %>
  </section>

  <div class="flex max-w-2xl flex-wrap items-center gap-3">
    <%= form.submit "Trocar senha", class: ApplicationHelper::BOTAO_PRIMARIO %>
    <% unless current_user.deve_trocar_senha? %>
      <%= link_to "Cancelar", root_path, class: ApplicationHelper::BOTAO_SECUNDARIO %>
    <% end %>
  </div>
<% end %>
