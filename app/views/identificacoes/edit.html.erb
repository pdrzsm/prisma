<% content_for :title, "Corrigir identificação · Prisma" %>
<%# iniciais_was: as do cadastro, mesmo quando a tela volta com erro %>
<% iniciais = @paciente.iniciais_was %>
<% notificacoes = @paciente.avaliacoes_clinicas.count %>
<% trilha ["Formulários", formularios_path], [@formulario.titulo, formulario_avaliacoes_clinicas_path(@formulario)],
         ["Notificação · #{iniciais}", formulario_avaliacao_clinica_path(@formulario, @notificacao)], ["Corrigir identificação"] %>

<div>
  <h1 class="text-2xl font-bold text-slate-900">Corrigir identificação · <%= iniciais %></h1>
  <p class="max-w-2xl text-sm text-slate-600">
    Para prontuário ou iniciais digitados errado. A correção vale para
    <%= notificacoes == 1 ? "a notificação" : "as #{notificacoes} notificações" %>
    deste paciente em <strong class="text-slate-900"><%= @paciente.setor.nome_completo %></strong> e fica no histórico,
    com o seu nome e o horário.
  </p>
</div>

<%= form_with model: @paciente, url: paciente_identificacao_path(@paciente), method: :patch, class: "space-y-6" do |form| %>
  <%= hidden_field_tag :avaliacao, @notificacao.id %>
  <section class="max-w-2xl space-y-5 rounded-xl border border-marca-200 bg-white p-6 shadow-sm">
    <%= render "shared/campo", form:, atributo: :prontuario_sah, rotulo: "Prontuário SAH", maximo: 30 %>
    <%= render "shared/campo", form:, atributo: :prontuario_aghuse, rotulo: "Prontuário AGHUSE", maximo: 30 %>
    <%= render "shared/campo", form:, atributo: :iniciais, rotulo: "Iniciais", maximo: 30,
               ajuda: "Até 10 letras, por exemplo: MSS. Pontos e espaços são ignorados." %>
    <p class="text-xs text-slate-600">Cada setor tem os seus pacientes: um prontuário não pode ser de dois pacientes do mesmo setor.</p>
  </section>

  <div class="flex max-w-2xl flex-wrap items-center gap-3">
    <%= form.submit "Salvar correção", class: ApplicationHelper::BOTAO_PRIMARIO %>
    <%= link_to "Cancelar", formulario_avaliacao_clinica_path(@formulario, @notificacao), class: ApplicationHelper::BOTAO_SECUNDARIO %>
  </div>
<% end %>
