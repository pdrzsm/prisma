<% content_for :title, "Notificação · #{@formulario.titulo} · Prisma" %>
<% paciente = @avaliacao.paciente %>
<%# O único script do sistema: imprimir não existe sem JavaScript (window.print).
    Só esta tela o carrega; a CSP só aceita script do próprio site. %>
<% content_for :head, javascript_include_tag("imprimir", defer: true) %>
<% trilha ["Formulários", formularios_path], [@formulario.titulo, formulario_avaliacoes_clinicas_path(@formulario)], ["Notificação · #{paciente.iniciais}"] %>

<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
      Notificação · <%= paciente.iniciais %> <%= selo_da_situacao(@avaliacao) %>
    </h1>
    <p class="text-sm text-slate-600">
      <%= @avaliacao.setor.nome_completo %> ·
      registrada por @<%= @avaliacao.user.username %> em <%= data_e_hora(@avaliacao.created_at) %>
      · atualizada em <%= data_e_hora(@avaliacao.updated_at) %>
    </p>
  </div>
  <div class="flex flex-wrap gap-3 print:hidden">
    <%# Imprime esta tela; a barra lateral, o topo e os botões ficam de fora (print:hidden) %>
    <button type="button" data-imprimir class="<%= ApplicationHelper::BOTAO_SECUNDARIO %> gap-2">
      <%= icone :impressora %>Imprimir
    </button>
    <% if policy(paciente).update? %>
      <%= link_to "Corrigir identificação", edit_paciente_identificacao_path(paciente, avaliacao: @avaliacao),
                  class: ApplicationHelper::BOTAO_SECUNDARIO %>
    <% end %>
    <% if policy(@avaliacao).update? %>
      <%= link_to "Editar", edit_formulario_avaliacao_clinica_path(@formulario, @avaliacao), class: ApplicationHelper::BOTAO_PRIMARIO %>
    <% end %>
  </div>
</div>

<%= render "versao", avaliacao: @avaliacao %>

<%# Cada parte da notificação é um cartão: faixa de título com a contagem e, embaixo,
    uma linha por pergunta (a pergunta à esquerda, a resposta em destaque à direita) %>
<% cartao = "overflow-hidden border border-marca-200 bg-white shadow-sm print:break-inside-avoid print:shadow-none" %>
<% faixa = "flex items-center justify-between gap-3 border-b border-marca-200 bg-marca-50 px-5 py-3" %>
<% linha = "grid gap-1 px-5 py-3 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-6" %>

<section class="<%= cartao %>">
  <header class="<%= faixa %>">
    <h2 class="flex items-center gap-2 text-base font-bold text-slate-900"><%= icone :usuarios, classe: "h-5 w-5 text-marca-600" %>Identificação do paciente</h2>
  </header>
  <dl class="divide-y divide-marca-100">
    <% Paciente::IDENTIFICACAO.each do |pergunta| %>
      <% resposta = paciente.public_send(pergunta.chave).presence %>
      <div class="<%= linha %>">
        <dt class="text-sm text-slate-600"><%= pergunta.texto %></dt>
        <dd class="text-sm <%= resposta ? "font-semibold text-slate-900" : "text-slate-500" %>"><%= resposta || "Não informado" %></dd>
      </div>
    <% end %>
  </dl>
</section>

<%# As respostas, com a versão do formulário em que a notificação foi registrada %>
<% @definicao.secoes.each do |secao| %>
  <% respondidas = secao.perguntas.count { |pergunta| !@avaliacao.respostas[pergunta.chave].nil? } %>
  <section class="<%= cartao %>">
    <header class="<%= faixa %>">
      <h2 class="flex items-center gap-2 text-base font-bold text-slate-900"><%= icone :documento, classe: "h-5 w-5 text-marca-600" %><%= secao.titulo %></h2>
      <p class="shrink-0 text-xs font-semibold uppercase tracking-wide text-slate-600"><%= respondidas %> de <%= secao.perguntas.size %> respondidas</p>
    </header>
    <dl class="divide-y divide-marca-100">
      <% secao.perguntas.each do |pergunta| %>
        <% resposta =
             if (valor = @avaliacao.respostas[pergunta.chave]).nil?
               @definicao.visivel?(pergunta, @avaliacao.respostas) ? nil : "Não se aplica"
             else
               @definicao.resposta_formatada(pergunta, valor)
             end %>
        <% encerramento = @definicao.campo_encerramento == pergunta.chave %>
        <div class="<%= linha %> <%= "bg-marca-50" if encerramento %>">
          <dt class="flex items-start gap-2 text-sm text-slate-600">
            <span class="mt-px inline-flex min-w-6 shrink-0 justify-center bg-marca-100 px-1 text-xs font-semibold text-marca-700"><%= pergunta.numero %></span>
            <span><%= pergunta.texto %><% if encerramento %> <span class="ml-1 text-xs font-semibold uppercase tracking-wide text-marca-700">encerramento</span><% end %></span>
          </dt>
          <dd class="whitespace-pre-line text-sm <%= resposta ? "font-semibold text-slate-900" : "text-slate-500" %>"><%= resposta || "Não informado" %></dd>
        </div>
      <% end %>
    </dl>
  </section>
<% end %>

<%= render "finalidade", finalidade: @avaliacao.finalidade, base_legal: @avaliacao.base_legal %>

<section class="bg-white rounded-xl border border-marca-200 shadow-sm p-6">
  <h2 class="text-lg font-bold text-slate-900 mb-4">Histórico de alterações</h2>
  <ol class="space-y-2 text-sm">
    <% @historico.each do |versao| %>
      <li class="flex gap-3">
        <span class="text-slate-600 whitespace-nowrap"><%= data_e_hora(versao.created_at) %></span>
        <span>
          <% if versao.item_type == Paciente.name %>
            Identificação do paciente corrigida
          <% else %>
            <%= versao.event == "create" ? "Criada" : "Alterada" %>
          <% end %>
          por
          @<%= @autores[versao.whodunnit]&.username || "sistema" %>
        </span>
      </li>
    <% end %>
  </ol>
</section>
