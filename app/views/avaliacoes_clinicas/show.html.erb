<% content_for :title, "Notificação · #{@formulario.titulo} · Prisma" %>
<% paciente = @avaliacao.paciente %>
<% trilha ["Formulários", formularios_path], [@formulario.titulo, formulario_avaliacoes_clinicas_path(@formulario)], ["Notificação · #{paciente.iniciais}"] %>

<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
      Notificação · <%= paciente.iniciais %> <%= selo_da_situacao(@avaliacao) %>
    </h1>
    <p class="text-sm text-slate-600">
      <%= @avaliacao.setor.nome_completo %> ·
      registrada por @<%= @avaliacao.user.username %> em <%= data_e_hora(@avaliacao.created_at) %>
      · atualizada em <%= data_e_hora(@avaliacao.updated_at) %>
    </p>
  </div>
  <div class="flex flex-wrap gap-3">
    <% if policy(paciente).update? %>
      <%= link_to "Corrigir identificação", edit_paciente_identificacao_path(paciente, avaliacao: @avaliacao),
                  class: ApplicationHelper::BOTAO_SECUNDARIO %>
    <% end %>
    <% if policy(@avaliacao).update? %>
      <%= link_to "Editar", edit_formulario_avaliacao_clinica_path(@formulario, @avaliacao), class: ApplicationHelper::BOTAO_PRIMARIO %>
    <% end %>
  </div>
</div>

<% @formulario.secoes.each do |secao| %>
  <section class="bg-white rounded-xl border border-marca-200 shadow-sm p-6">
    <h2 class="text-lg font-bold text-slate-900 mb-4"><%= secao.titulo %></h2>
    <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
      <% secao.perguntas.each do |pergunta| %>
        <% resposta =
             if pergunta.paciente
               paciente.public_send(pergunta.chave).presence
             elsif (valor = @avaliacao.respostas[pergunta.chave]).nil?
               @formulario.condicao_atendida?(pergunta, @avaliacao.respostas) ? nil : "Não se aplica"
             else
               @formulario.resposta_formatada(pergunta, valor)
             end %>
        <div>
          <dt class="text-xs font-semibold text-slate-600"><%= pergunta.numero %>. <%= pergunta.texto %></dt>
          <dd class="mt-1 text-sm <%= resposta ? "text-slate-900" : "text-slate-400" %>"><%= resposta || "Não informado" %></dd>
        </div>
      <% end %>
    </dl>
  </section>
<% end %>

<section class="bg-white rounded-xl border border-marca-200 shadow-sm p-6">
  <h2 class="text-lg font-bold text-slate-900 mb-4">Histórico de alterações</h2>
  <ol class="space-y-2 text-sm">
    <% @historico.each do |versao| %>
      <li class="flex gap-3">
        <span class="text-slate-600 whitespace-nowrap"><%= data_e_hora(versao.created_at) %></span>
        <span>
          <% if versao.item_type == Paciente.name %>
            Identificação do paciente corrigida
          <% else %>
            <%= versao.event == "create" ? "Criada" : "Alterada" %>
          <% end %>
          por
          @<%= @autores[versao.whodunnit]&.username || "sistema" %>
        </span>
      </li>
    <% end %>
  </ol>
</section>
