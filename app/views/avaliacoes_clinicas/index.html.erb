<% content_for :title, "#{@formulario.titulo} · Prisma" %>
<%# Só os setores em que a pessoa consulta este formulário (o controller filtra);
    com mais de um, a lista ganha o filtro e a coluna de setor %>
<% varios_setores = @setores.size > 1 %>
<% filtros = { prontuario: params[:prontuario].presence, setor: @setor_filtrado&.id } %>
<% trilha ["Formulários", formularios_path], [@formulario.titulo] %>
<h1 class="sr-only"><%= @formulario.titulo %></h1>

<%# Barra da lista: o botão Filtros (abre o painel lateral), os filtros em uso
    como etiquetas que se desfazem com um clique, e o Nova notificação %>
<% lista = formulario_avaliacoes_clinicas_path(@formulario) %>
<% campo_de_filtro = "block w-full border border-marca-300 bg-marca-50 px-3 py-2 text-sm font-semibold text-slate-700 placeholder:text-slate-500 focus:border-marca-700 focus:outline-none focus:ring-1 focus:ring-marca-700" %>
<div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
  <div class="flex flex-wrap items-center gap-3">
    <%= link_to formulario_avaliacoes_clinicas_path(@formulario, **filtros, filtros: 1), class: "#{ApplicationHelper::BOTAO_SECUNDARIO} h-10 gap-2" do %>
      <%= icone :filtro %>Filtros<% if filtros.values.any? %> <span class="bg-marca-600 px-1.5 text-xs text-white"><%= filtros.values.count(&:present?) %></span><% end %>
    <% end %>
    <% if filtros[:prontuario] %>
      <%= link_to formulario_avaliacoes_clinicas_path(@formulario, **filtros, prontuario: nil), class: "inline-flex items-center gap-1.5 border border-marca-300 bg-white px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-marca-50", aria: { label: "Tirar a busca" } do %>
        Busca: <%= filtros[:prontuario] %><%= icone :fechar, classe: "h-3 w-3" %>
      <% end %>
    <% end %>
    <% if @setor_filtrado %>
      <%= link_to formulario_avaliacoes_clinicas_path(@formulario, **filtros, setor: nil), class: "inline-flex items-center gap-1.5 border border-marca-300 bg-white px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-marca-50", aria: { label: "Tirar o filtro de setor" } do %>
        Setor: <%= @setor_filtrado.nome_completo %><%= icone :fechar, classe: "h-3 w-3" %>
      <% end %>
    <% end %>
    <% if filtros.values.any? %>
      <%= link_to "Limpar", lista, class: "#{ApplicationHelper::BOTAO_SECUNDARIO} h-10" %>
    <% end %>
  </div>
  <% if policy(AvaliacaoClinica.new(formulario: @formulario.chave)).new? %>
    <%= link_to com_icone(:mais, "Nova notificação"), new_formulario_avaliacao_clinica_path(@formulario), class: "#{ApplicationHelper::BOTAO_PRIMARIO} h-10" %>
  <% end %>
</div>

<% if params[:filtros].present? %>
  <% painel_lateral "Filtros", fechar: formulario_avaliacoes_clinicas_path(@formulario, **filtros), simbolo: :filtro do %>
    <%= form_with url: lista, method: :get, html: { role: "search" }, class: ModalHelper::PAINEL_FORMULARIO do |busca| %>
      <div class="<%= ModalHelper::PAINEL_CORPO %>">
        <div class="space-y-1.5">
          <%= busca.label :prontuario, "Prontuário ou iniciais", class: "block text-xs font-semibold uppercase tracking-wider text-slate-600" %>
          <%= busca.search_field :prontuario, value: params[:prontuario], autocomplete: "off", autofocus: true,
                                 placeholder: "Digite parte do prontuário ou as iniciais", list: "sugestoes_de_busca", class: campo_de_filtro %>
          <datalist id="sugestoes_de_busca">
            <% Array(@sugestoes).each do |sugestao| %><option value="<%= sugestao %>"></option><% end %>
          </datalist>
          <p class="text-xs text-slate-600">Acha por qualquer parte do prontuário (SAH ou AGHUSE) ou das iniciais; as sugestões vêm dos registros que você vê.</p>
        </div>
        <% if varios_setores %>
          <div class="space-y-1.5">
            <%= busca.label :setor, "Setor", class: "block text-xs font-semibold uppercase tracking-wider text-slate-600" %>
            <%= busca.select :setor, @setores.map { |setor| [ setor.nome_completo, setor.id ] },
                             { include_blank: "Todos os setores", selected: @setor_filtrado&.id }, class: campo_de_filtro %>
          </div>
        <% end %>
      </div>
      <div class="<%= ModalHelper::PAINEL_RODAPE %>">
        <%= link_to "Limpar", lista, class: "#{ApplicationHelper::BOTAO_SECUNDARIO} h-10" %>
        <%= busca.button type: :submit, name: nil, class: "#{ApplicationHelper::BOTAO_PRIMARIO} h-10 gap-2" do %><%= icone :busca %>Aplicar filtros<% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if @avaliacoes.empty? %>
  <div class="bg-white rounded-xl border border-marca-200 p-8 text-center text-sm text-slate-600">
    <% if @paginacao.total.positive? %>
      Não há registros nesta página. <%= link_to "Voltar à primeira página", formulario_avaliacoes_clinicas_path(@formulario, **filtros), class: "font-semibold text-marca-700 hover:underline" %>
    <% elsif filtros.values.any? %>
      Nenhum registro com esse filtro.
    <% else %>
      Nenhum registro ainda.
    <% end %>
  </div>
<% else %>
  <%# A mesma lista, com os mesmos filtros, na página dada (a primeira não leva o número na URL) %>
  <% caminho = ->(pagina) { formulario_avaliacoes_clinicas_path(@formulario, **filtros, pagina: (pagina if pagina > 1)) } %>
  <%= render "avaliacoes_clinicas/planilha", formulario: @formulario, definicao: @definicao, avaliacoes: @avaliacoes, autores: @autores,
                                             varios_setores: varios_setores, paginacao: @paginacao, caminho: %>
<% end %>
