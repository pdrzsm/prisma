<% content_for :title, "#{@formulario.titulo} · Prisma" %>

<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
  <div>
    <p class="text-sm text-slate-500"><%= link_to "Formulários", formularios_path, class: "hover:text-slate-800" %> /</p>
    <h1 class="text-2xl font-bold text-slate-900"><%= @formulario.titulo %></h1>
  </div>
  <% if policy(AvaliacaoClinica).create? %>
    <%= link_to "Nova notificação", new_formulario_avaliacao_clinica_path(@formulario), class: ApplicationHelper::BOTAO_PRIMARIO %>
  <% end %>
</div>

<%= form_with url: formulario_avaliacoes_clinicas_path(@formulario), method: :get, class: "flex flex-col sm:flex-row gap-3 sm:items-end" do |busca| %>
  <div class="sm:w-80">
    <%= busca.label :prontuario, "Buscar por prontuário (SAH ou AGHUSE)", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= busca.text_field :prontuario, value: params[:prontuario], autocomplete: "off", class: ApplicationHelper::CAMPO %>
  </div>
  <div class="flex gap-3">
    <%= busca.submit "Buscar", name: nil, class: ApplicationHelper::BOTAO_SECUNDARIO %>
    <% if params[:prontuario].present? %>
      <%= link_to "Limpar", formulario_avaliacoes_clinicas_path(@formulario), class: "self-center text-sm text-slate-600 hover:text-slate-900" %>
    <% end %>
  </div>
<% end %>

<% if @avaliacoes.empty? %>
  <div class="bg-white rounded-xl border border-slate-200 p-8 text-center text-sm text-slate-600">
    <% if params[:prontuario].present? %>
      Nenhum registro com esse prontuário.
    <% elsif @pagina > 1 %>
      Não há registros nesta página. <%= link_to "Voltar à primeira página", formulario_avaliacoes_clinicas_path(@formulario), class: "font-semibold text-indigo-700" %>
    <% else %>
      Nenhum registro ainda.
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
        <tr>
          <th scope="col" class="px-4 py-3">Iniciais</th>
          <th scope="col" class="px-4 py-3">Prontuário SAH</th>
          <th scope="col" class="px-4 py-3">Prontuário AGHUSE</th>
          <% @formulario.perguntas_da_lista.each do |pergunta| %>
            <th scope="col" class="px-4 py-3"><%= pergunta.texto %></th>
          <% end %>
          <th scope="col" class="px-4 py-3">Situação</th>
          <th scope="col" class="px-4 py-3">Atualizada em</th>
          <th scope="col" class="px-4 py-3"><span class="sr-only">Ações</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @avaliacoes.each do |avaliacao| %>
          <tr>
            <td class="px-4 py-3 font-semibold text-slate-900"><%= avaliacao.paciente.iniciais %></td>
            <td class="px-4 py-3"><%= avaliacao.paciente.prontuario_sah || "—" %></td>
            <td class="px-4 py-3"><%= avaliacao.paciente.prontuario_aghuse || "—" %></td>
            <% @formulario.perguntas_da_lista.each do |pergunta| %>
              <% valor = avaliacao.respostas[pergunta.chave] %>
              <td class="px-4 py-3"><%= valor.nil? ? "—" : @formulario.resposta_formatada(pergunta, valor) %></td>
            <% end %>
            <td class="px-4 py-3"><%= selo_da_situacao(avaliacao) %></td>
            <td class="px-4 py-3 whitespace-nowrap text-slate-600"><%= data_e_hora(avaliacao.updated_at) %></td>
            <td class="px-4 py-3 whitespace-nowrap text-right">
              <%= link_to "Ver", formulario_avaliacao_clinica_path(@formulario, avaliacao), class: "font-semibold text-indigo-700 hover:text-indigo-900" %>
              <% if policy(avaliacao).update? %>
                <%= link_to "Editar", edit_formulario_avaliacao_clinica_path(@formulario, avaliacao), class: "ml-3 font-semibold text-indigo-700 hover:text-indigo-900" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <nav aria-label="Páginas" class="flex justify-between text-sm">
    <span>
      <% if @pagina > 1 %>
        <%= link_to "← Anterior", formulario_avaliacoes_clinicas_path(@formulario, prontuario: params[:prontuario].presence, pagina: @pagina - 1), class: "font-semibold text-indigo-700" %>
      <% end %>
    </span>
    <span>
      <% if @tem_proxima %>
        <%= link_to "Próxima →", formulario_avaliacoes_clinicas_path(@formulario, prontuario: params[:prontuario].presence, pagina: @pagina + 1), class: "font-semibold text-indigo-700" %>
      <% end %>
    </span>
  </nav>
<% end %>
