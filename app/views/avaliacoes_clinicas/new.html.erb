<% content_for :title, "Nova notificação · #{@formulario.titulo} · Prisma" %>
<% trilha ["Formulários", formularios_path], [@formulario.titulo, formulario_avaliacoes_clinicas_path(@formulario)], ["Nova notificação"] %>

<div>
  <h1 class="text-2xl font-bold text-slate-900">Nova notificação</h1>
  <p class="text-sm text-slate-600"><%= @formulario.descricao %></p>
</div>

<%= render "formulario", url: formulario_avaliacoes_clinicas_path(@formulario), metodo: :post %>
