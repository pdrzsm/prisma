<% content_for :title, "Nova notificação · #{@formulario.titulo} · Prisma" %>
<% trilha ["Formulários", formularios_path], [@formulario.titulo, formulario_avaliacoes_clinicas_path(@formulario)], ["Nova notificação"] %>

<div>
  <h1 class="text-2xl font-bold text-slate-900">Nova notificação</h1>
  <% if @definicao.descricao %>
    <p class="max-w-3xl whitespace-pre-line text-sm text-slate-600"><%= @definicao.descricao %></p>
  <% end %>
</div>

<%= render "finalidade", finalidade: @definicao.finalidade, base_legal: @definicao.base_legal %>

<%= render "formulario", definicao: @definicao, url: formulario_avaliacoes_clinicas_path(@formulario), metodo: :post %>
